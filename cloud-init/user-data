#cloud-config

bootcmd:
# These next 3 lines are an ugly hack to "trick" subiquity.
# The "proper" / expected way to get subiquity to autoinstall completely
# non-interactively is to add the kernel parameter "autoinstall".

# I don't want to modify the iso file (to change the grub.cfg), and I
# don't want to load the kernel directly via qemu (which would require
# extracting the kernel and initramfs from the iso image ahead of time,
# and either hard coding the standard kernel parameters or somehow
# extracting them as well).

# /proc/cmdline is a read-only file exposed by procfs and cannot be
# modified after the kernel is loaded.

# I can however create a writeable file, append ' autoinstall' to it, and
# then bind mount it over the *path* /proc/cmdline.

# Subiquity then sees 'autoinstall' when it checks, and doesn't ask for
# user confirmation before partitioning and installing.

- [ install, --mode, 644, /proc/cmdline, /cmdline_override.txt ]
- echo ' autoinstall' >> /cmdline_override.txt
- [ mount, --bind, /cmdline_override.txt, /proc/cmdline ]


autoinstall:
  version: 1
  storage:
    config:
    - grub_device: true
      id: disk-sda
      path: /dev/sda
      ptable: gpt
      type: disk
      wipe: superblock-recursive
    - device: disk-sda
      flag: bios_grub
      id: partition-0
      number: 1
      size: 1048576
      type: partition
    - device: disk-sda
      id: partition-1
      number: 2
      size: -1
      type: partition
      wipe: superblock
    - fstype: btrfs
      id: format-0
      type: format
      volume: partition-1
    - device: format-0
      id: mount-0
      path: /
      type: mount

  # APT configuration (for selecting main software update source by default instead of the local mirror)
  apt:
    mirror-selection:
      primary:
        - uri: "http://archive.ubuntu.com/ubuntu"
          arches: [amd64, i386]
        - uri: "http://ports.ubuntu.com/ubuntu-ports"
          arches: [s390x, arm64, armhf, powerpc, ppc64el, riscv64]
    fallback: abort
    geoip: false

  # Updates, the type that will be downloaded and installed after the system installation, and before rebooting into the target system
  # Updates from both the security and updates pockets are installed.
  updates: all

  # Shutdown configuration
  shutdown: poweroff
